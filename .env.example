# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env

# --- server ---
CORTANA_SERVER_HOST=0.0.0.0
CORTANA_SERVER_PORT=8080
CORTANA_DATA_DIR=/data
# Public URL of this server (used to build OAuth redirect URIs).
CORTANA_PUBLIC_URL=http://localhost:8080

# --- token encryption (REQUIRED for connector storage) ---
# Generate:  openssl rand -base64 32
CORTANA_TOKEN_KEY=

# --- database (reference impl uses sqlite; leave unset) ---
# DATABASE_URL=postgresql://cortana:secret@db:54360/cortana

# --- hosted chat (OpenAI-compatible /v1/chat/completions) ---
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, Groq, Together...).
CORTANA_CHAT_PROVIDER=openai
CORTANA_CHAT_BASE_URL=https://api.openai.com/v1
CORTANA_CHAT_API_KEY=
CORTANA_CHAT_MODEL=gpt-4o-mini

# --- OAuth apps (ONE registration per provider, held by the server) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple Sign In needs a Services ID + signed client_secret (see server/README.md).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PEM=

# --- tuning ---
CORTANA_SESSION_TTL=2592000
CORTANA_PAIRING_TTL=600
CORTANA_RATE_LIMIT=120

# --- compose-only (postgres/redis for the production path) ---
POSTGRES_USER=cortana
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_DB=cortana
REDIS_PASSWORD=change-me-in-.env
